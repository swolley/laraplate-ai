includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    # Livello di analisi (0-9, max = 9)
    level: 5

    tmpDir: /tmp/phpstan
    
    # Directory da analizzare
    paths:
        - app/
        - config
        - database
        - routes
    
    # File da escludere
    excludePaths:
        - vendor/**
        # Files that depend on Core module or parent app (not available standalone)
        - app/Services/Translation/DeepLTranslationService.php
        - app/Providers/AIServiceProvider.php
        - app/Providers/RouteServiceProvider.php
        - app/Http/Controllers/**
        - app/Console/**
        
    # Ignora errori specifici
    ignoreErrors:
        - 
          message: "#Called 'env' outside of the config directory which returns null when the config is cached, use 'config'.$#"
          identifier: larastan.noEnvCallsOutsideOfConfig
          reportUnmatched: false
        -
          message: '#PHPDoc tag @mixin contains unknown class.*IdeHelper.*#'
          reportUnmatched: false
        -
          message: '#Call to an undefined method.*::searchableAs\(\)#'
          reportUnmatched: false
        -
          message: '#Parameter.*\$ttl.*Cache::remember.*array given#'
          reportUnmatched: false
        # Core module dependencies (not available in standalone mode)
        -
          message: '#.*Modules.Core.*#'
          reportUnmatched: false
        # Eloquent model properties resolved by IdeHelper (not generated in standalone)
        -
          identifier: property.notFound
          reportUnmatched: false
        # Parent app classes not available standalone (App\Http\Controllers\Controller)
        -
          message: '#extends unknown class App\\\\#'
          reportUnmatched: false
        # Core module helper functions (class_uses_trait, models)
        -
          message: '#Function (class_uses_trait|models) not found#'
          reportUnmatched: false
        # User model methods from Core (hasRole, etc.)
        -
          message: '#Call to an undefined method.*Auth\\\\User::#'
          reportUnmatched: false
        # Model belongsTo with Core User class string
        -
          message: '#expects class-string.*Model.*, string given#'
          reportUnmatched: false
        # Core module trait methods on Eloquent models (prepareDataToEmbed, embeddings, etc.)
        -
          message: '#Call to an undefined method.*::(prepareDataToEmbed|embeddings)\(\)#'
          reportUnmatched: false
        # Pre-existing issues in Jobs/Listeners (Core module dependent)
        -
          identifier: arguments.count
          path: app/Listeners/*
          reportUnmatched: false
        -
          identifier: booleanNot.alwaysFalse
          reportUnmatched: false

    # Configurazione per Laravel
    checkModelProperties: true
    checkOctaneCompatibility: true
    noEnvCallsOutsideOfConfig: true
    checkModelAppends: true